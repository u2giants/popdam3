# Minimal runtime-only image for CI (Node build happens in the runner, not here)
FROM nginxinc/nginx-unprivileged:1.29-alpine
LABEL org.opencontainers.image.source="https://github.com/u2giants/popdam3"
LABEL org.opencontainers.image.description="PopDAM frontend"
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
USER root
RUN chmod -R a+rX /usr/share/nginx/html
USER nginx
EXPOSE 8080 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://localhost:8080/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
