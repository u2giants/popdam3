  "description": "PopDAM Bridge Agent — multi-tenant NAS scanner, thumbnail generator, and cloud sync worker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node ../../packages/agent-common/sync.mjs",
