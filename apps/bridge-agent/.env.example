# PopDAM Bridge Agent — Environment Variables
# Copy to .env and fill in the two required values.
# All other settings are configured automatically via PopDAM Settings.

# ── Cloud API (required — outbound HTTPS only) ───────────────
SUPABASE_URL=https://ryltkzzernhwnojzouyb.supabase.co
AGENT_KEY=your-agent-key-here

# Supabase anon (public) key — enables instant command delivery via Realtime.
# Without this, scan triggers, dir browse, and path tests wait up to 30s for heartbeat.
# This is the publishable key — safe to commit and distribute.
SUPABASE_ANON_KEY=sb_publishable_7pDNMn_LIJOkdYmhcI0n7g_IuKABuWK

# ── NAS Filesystem ───────────────────────────────────────────
NAS_CONTAINER_MOUNT_ROOT=/mnt/nas/mac
SCAN_ROOTS=/mnt/nas/mac

# ── Performance — FALLBACK values only. ──────────────────────
# Settings → Scanning → Resource Guard in the admin panel
# takes priority and overrides these at runtime via
# heartbeat config. Only change these if the agent
# won't start or cloud config isn't being delivered.
THUMB_CONCURRENCY=2
INGEST_BATCH_SIZE=100

# ── Self-Update ───────────────────────────────────────────────
# Path to docker-compose.yml for self-update restarts.
# Default: /volume1/docker/popdam/docker-compose.yml
# POPDAM_COMPOSE_PATH=/volume1/docker/popdam/docker-compose.yml

# All other settings (DigitalOcean Spaces credentials, scan folders, etc.)
# are delivered automatically via heartbeat config sync.
# Configure them in PopDAM Settings → NAS & Storage.