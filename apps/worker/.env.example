# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://ryltkzzernhwnojzouyb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Gemini API key (for AI asset tagging)
GOOGLE_AI_API_KEY=AIza...

# Anthropic API key (for ERP product classification)
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional tuning ────────────────────────────────────────────────────────────
# How often to poll for pending operations (milliseconds). Default: 5000
WORKER_POLL_INTERVAL_MS=5000

# Max parallel Gemini calls per AI tagging batch. Default: 15 (safe for pay-as-you-go 2000 RPM)
AI_BATCH_CONCURRENCY=15

# Assets fetched per AI tagging batch (must be >= AI_BATCH_CONCURRENCY). Default: 15
AI_BATCH_SIZE=15
