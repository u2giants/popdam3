{
  "name": "popdam-worker",
  "version": "1.4.7",
  "description": "PopDAM Cloud Worker — persistent batch processor for AI tagging, style group rebuild, and ERP classification",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "SUPABASE_URL=http://localhost SUPABASE_SERVICE_ROLE_KEY=test tsx --test src/*.test.ts src/**/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@supabase/supabase-js": "^2.43.0",
    "undici": "6.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
