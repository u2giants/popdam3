{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--project-ref", "qsllyeztdwjgirsysgai"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "devops-mcp": {
      "type": "http",
      "url": "https://mcp.designflow.app/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVOPS_MCP_TOKEN}"
      }
    },
    "synology-monitor": {
      "type": "http",
      "url": "https://nas-mcp.designflow.app/mcp",
      "headers": {
        "Authorization": "Bearer ${NAS_MCP_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/playwright"
      }
    }
  }
}
