{
  "mcpServers": {
    "supabase": {
      "command": "bash",
      "args": [
        "scripts/mcp/supabase-mcp.sh",
        "--project-ref",
        "qsllyeztdwjgirsysgai"
      ]
    },
    "devops-mcp": {
      "type": "http",
      "url": "https://mcp.designflow.app/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVOPS_MCP_TOKEN}"
      }
    },
    "synology-monitor": {
      "type": "http",
      "url": "https://nas-mcp.designflow.app/mcp",
      "headers": {
        "Authorization": "Bearer ${NAS_MCP_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/playwright"
      }
    }
  }
}
