{
  "name": "36-cron-runs-by-hour",
  "sql": "select date_trunc('hour', r.start_time) as hour_utc, j.jobname, r.status, count(*) as runs, round(sum(extract(epoch from (r.end_time - r.start_time)))::numeric, 1) as total_duration_s from cron.job_run_details r left join cron.job j on j.jobid = r.jobid where r.start_time > now() - interval '7 days' group by 1,2,3 order by 1 desc, 2 limit 120",
