{
  "name": "Pop Mockups",
  "short_name": "Pop Mockups",
  "description": "Turn Illustrator files into 3D product mockups.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#f05752",
  "icons": [
    {
      "src": "icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-popmockup": [
          ".popmockup"
        ],
        "application/x-popshow": [
          ".popshow"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/postscript": [
          ".ai"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}